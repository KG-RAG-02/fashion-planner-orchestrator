  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "StructuredQuery 1.0: one natural-language query structured with the K-Fashion standard\nvocabulary. Definition: docs/contracts/structured-query.md (owner: vogue-orchestrator).",
  "properties": {
    "missing_fields": {
      "items": {
        "type": "string"
      },
      "title": "Missing Fields",
      "type": "array"
    },
    "original_query": {
      "minLength": 1,
      "title": "Original Query",
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "requested": {
      "$ref": "#/$defs/Requested"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trend_terms": {
      "$ref": "#/$defs/TrendTerms"
    },
    "unsupported": {
      "items": {
        "$ref": "#/$defs/UnsupportedCondition"
      },
      "title": "Unsupported",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "original_query",
    "trend_terms",
    "requested",
    "unsupported",
    "missing_fields"
  ],
  "title": "StructuredQuery",
  "type": "object"
