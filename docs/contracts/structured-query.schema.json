        "origin": {
          "enum": [
            "user_requested",
            "default_next"
          ],
          "title": "Origin",
          "type": "string"
        },
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw"
        },
        "season": {
          "enum": [
            "SS",
            "FW"
          ],
          "title": "Season",
          "type": "string"
