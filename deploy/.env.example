# Key reference for the VOGUE deployment env file.
# The real file lives OUTSIDE the project (iCloud) at ~/.config/vogue/vogue.env (mode 600)
# and is created by `deploy/bin/vogue init-env`. Never commit real values.

# --- every profile -------------------------------------------------------
FASHION_PLANNER_SERVICE_TOKEN=   # generated fresh by init-env; shared by the five services
NEO4J_STUB_PASSWORD=                # generated; throwaway stub graph only

# --- data profile (rehearsal, live): Cloudflare R2 ------------------------
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_DB_KEY=
R2_IMAGE_PREFIX=

# --- data profile: Neo4j Aura (trend graph) --------------------------------
NEO4J_URI=                          # neo4j+s://<instance>.databases.neo4j.io
NEO4J_USER=
NEO4J_PASSWORD=

# --- paid profile (live only): OpenAI ---------------------------------------
FASHION_PLANNER_OPENAI_API_KEY=
FASHION_PLANNER_ORCHESTRATOR_LLM_MODEL=gpt-4o-mini     # orchestrator query structuring
# FASHION_PLANNER_RESEARCH_LLM_MODEL=gpt-6-luna   # optional: P07 target-audience hypothesis (compose.paid.yaml default gpt-6-luna)
FASHION_PLANNER_NOVELTY_IMAGE_MODEL=                  # empty = orchestrator default image model
