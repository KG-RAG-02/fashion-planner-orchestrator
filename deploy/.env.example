# Key reference for the Fashion Planner deployment env file.
# The real file lives OUTSIDE the repository at ~/.config/fashion-planner/fashion-planner.env (mode 600)
# and is created by `deploy/bin/fashion-planner init-env`. Never commit real values.

# --- every profile -------------------------------------------------------
FASHION_PLANNER_SERVICE_TOKEN=   # generated fresh by init-env; shared by the five services
NEO4J_STUB_PASSWORD=             # generated; throwaway stub graph only
# Trend article photos on the planning sheet: off while blank (the UI and sheet only link to them). Naming hosts
# (e.g. vogue.co.kr) makes stage 06 download up to 3 photos; that use is your responsibility and sheets with
# those photos must not be redistributed.
FASHION_PLANNER_TREND_PHOTO_HOSTS=

# --- data profile (rehearsal, live): Cloudflare R2 ------------------------
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_DB_KEY=
R2_IMAGE_PREFIX=
RESEARCH_AGGREGATE_SNAPSHOT_KEY=   # content-addressed R2 key of research's precomputed H&M aggregate

# --- data profile: research opt-in (off unless set to 1) -------------------
# H&M Kaggle data may be used for non-commercial research only. Set 1 only if your use qualifies;
# otherwise research reports its H&M sources as not configured.
RESEARCH_HM_NONCOMMERCIAL_RESEARCH=0

# --- data profile: Neo4j Aura (trend graph) --------------------------------
NEO4J_URI=                       # neo4j+s://<instance>.databases.neo4j.io
NEO4J_USER=
NEO4J_PASSWORD=

# --- paid profile (live only): OpenAI ---------------------------------------
FASHION_PLANNER_OPENAI_API_KEY=
FASHION_PLANNER_ORCHESTRATOR_LLM_MODEL=gpt-4o-mini   # orchestrator query structuring and SWOT draft
# FASHION_PLANNER_RESEARCH_LLM_MODEL=gpt-6-luna      # optional: research target-audience hypothesis
FASHION_PLANNER_NOVELTY_IMAGE_MODEL=                 # empty = novelty's default image model
# Set 1 to let research send its target-audience inputs (allowed product fields, age and fabric
# aggregates) to the external LLM. Off by default.
RESEARCH_TARGET_LLM_TRANSFER_AUTHORIZED=0
