{
  "schema_version": 1,
  "_about": "host 모드 실행 목록(scripts/local_servers.py). 각 레포를 이 레포 옆(../<repo>)에 둔다. 컨테이너 실행은 deploy/compose*.yaml을 쓴다.",
  "services": {
    "orchestrator": {
      "repo": "fashion-planner-orchestrator",
      "python": "3.12",
      "port": 8765,
      "command": ["python", "app.py"],
      "health": {"path": "/api/health"}
    },
    "trend": {
      "repo": "fashion-planner-trend",
      "python": "3.12",
      "port": 8768,
      "command": ["python", "-m", "fashion_planner_trend.api.server", "--host", "0.0.0.0", "--port", "8768", "--mode", "service"],
      "health": {"path": "/health"}
    },
    "inventory": {
      "repo": "fashion-planner-inventory",
      "python": "3.12",
      "port": 8002,
      "command": ["python", "-m", "fashion_planner_inventory.server", "--host", "0.0.0.0"],
      "health": {"path": "/health/live"}
    },
    "novelty": {
      "repo": "fashion-planner-novelty",
      "python": "3.12",
      "port": 8767,
      "command": ["python", "-m", "fashion_planner_novelty.server"],
      "health": {"path": "/api/health"}
    },
    "research": {
      "repo": "fashion-planner-research",
      "python": "3.14",
      "port": 8766,
      "command": ["python", "-m", "fashion_planner_research.http_server", "--host", "0.0.0.0", "--port", "8766", "--service-mode"],
      "health": {"path": "/api/health"}
    }
  }
}
