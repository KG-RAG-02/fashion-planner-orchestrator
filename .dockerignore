# Build context allowlist: only what the runtime image needs (see Dockerfile).
*
!app.py
!pyproject.toml
!src/fashion_planner_orchestrator
!web
!configs
!prompts
!contracts
!examples/fixtures/query

# Never in the context, even inside the directories above: local state, secrets,
# iCloud conflict copies ("name 2.ext"), caches, and repository-only material.
.git
.env*
**/.env*
.local
**/.local
**/* [0-9]
**/* [0-9].*
**/__pycache__
**/*.py[cod]
**/.DS_Store
tests
tools
deploy
docs
