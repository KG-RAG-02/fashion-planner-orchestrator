# Copy to the ignored project-root .env and source it before starting Project_08.
# Loopback URLs are development-only. Production endpoints must use HTTPS.
VOGUE_AGENT_HTTP_DEV_MODE=1

# Trend local route exists, but has no authentication/TLS and needs a connected Neo4j graph.
VOGUE_TREND_AGENT_URL=http://127.0.0.1:8768
VOGUE_STOCK_AGENT_URL=http://127.0.0.1:8002
VOGUE_SALES_MARKET_AGENT_URL=http://127.0.0.1:8766
VOGUE_NEW_PRODUCT_AGENT_URL=http://127.0.0.1:8767

# Stock requires this Bearer token even in local development. Use the same
# secret value as STOCK_AGENT_SERVICE_TOKEN in the Stock service environment.
# Leave blank in the template; never commit an actual token.
VOGUE_AGENT_SERVICE_BEARER_TOKEN=
