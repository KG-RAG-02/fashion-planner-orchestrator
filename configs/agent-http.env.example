# Copy to the ignored project-root .env and source it before starting Project_08.
# Loopback URLs are development-only. Production endpoints must use HTTPS.
FASHION_PLANNER_HTTP_DEV_MODE=1

# Trend route requires the shared Bearer token; TLS is not configured locally and a Neo4j graph is required.
ORCHESTRATOR_TREND_URL=http://127.0.0.1:8768
ORCHESTRATOR_INVENTORY_URL=http://127.0.0.1:8002
ORCHESTRATOR_NOVELTY_URL=http://127.0.0.1:8767
ORCHESTRATOR_RESEARCH_URL=http://127.0.0.1:8766
# orchestrator calls novelty for Draft and product/outfit visuals, then calls research for market review.

# Trend, Stock, novelty, and research use this shared Bearer token, including
# loopback development. Set FASHION_PLANNER_SERVICE_TOKEN in each service environment.
# Leave blank in the template; never commit an actual token.
FASHION_PLANNER_SERVICE_TOKEN=
