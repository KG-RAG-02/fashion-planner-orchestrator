{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.fashion-planner.invalid/orchestrator/planning-draft-request.schema.json",
  "title": "orchestrator to novelty novelty-handoff request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "input"
  ],
  "properties": {
    "contract_version": {
      "const": "novelty-handoff"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planning_request",
        "trend_result",
        "inventory_product_result"
      ],
      "properties": {
        "planning_request": {
          "type": "object",
          "required": [
            "schema_version",
            "request_id"
          ],
          "properties": {
            "schema_version": {
              "const": "1.0.0"
            },
            "request_id": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "additionalProperties": true
        },
        "trend_result": {
          "type": "object",
          "required": [
            "schema_version",
            "request_id",
            "status"
          ],
          "properties": {
            "schema_version": {
              "const": "1.0.0"
            },
            "request_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "status": {
              "$ref": "common.schema.json#/$defs/status"
            }
          },
          "additionalProperties": true
        },
        "inventory_product_result": {
          "type": "object",
          "required": [
            "schema_version",
            "request_id",
            "agent_id",
            "status"
          ],
          "properties": {
            "schema_version": {
              "const": "1.0.0"
            },
            "request_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "agent_id": {
              "const": "inventory"
            },
            "status": {
              "$ref": "common.schema.json#/$defs/status"
            }
          },
          "additionalProperties": true
        }
      }
    }
  }
}
