{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.vogue.invalid/workflow/2.0/planning-draft-response.schema.json",
  "title": "P06 vogue-handoff/0.3 response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "producer",
    "status",
    "result"
  ],
  "properties": {
    "contract_version": {
      "const": "vogue-handoff/0.3"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "schema_version"
      ],
      "properties": {
        "agent_id": {
          "const": "new-product-agent"
        },
        "schema_version": {
          "const": "1.0"
        }
      }
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "result": {
      "type": "object",
      "required": [
        "schema_version",
        "request_id",
        "status",
        "draft",
        "input_evidence"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "request_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "status": {
          "$ref": "common.schema.json#/$defs/status"
        },
        "draft": {
          "anyOf": [
            {"type": "object"},
            {"type": "null"}
          ]
        },
        "input_evidence": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  }
}
