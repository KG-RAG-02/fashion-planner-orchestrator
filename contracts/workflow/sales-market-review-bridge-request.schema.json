{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.vogue.invalid/workflow/2.0/sales-market-review-bridge-request.schema.json",
  "title": "P08 to P06 post-Draft sales market projection request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "input"],
  "properties": {
    "contract_version": {"const": "vogue-sales-market-review/0.1-proposal"},
    "request_id": {"$ref": "common.schema.json#/$defs/id"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "planning_draft"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/id"},
        "planning_draft": {
          "type": "object",
          "required": ["schema_version", "request_id", "draft", "evidence_ids"],
          "properties": {
            "schema_version": {"const": "1.0"},
            "request_id": {"$ref": "common.schema.json#/$defs/id"},
            "draft": {"type": "object", "required": ["product_profile"], "properties": {"product_profile": {"type": "object"}}},
            "evidence_ids": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  }
}
