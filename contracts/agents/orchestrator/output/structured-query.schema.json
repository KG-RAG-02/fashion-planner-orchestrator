        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "type": {
          "enum": [
            "brand",
            "category",
            "attribute",
            "abstract",
            "price",
            "market",
            "channel",
            "age",
            "other"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "raw",
        "reason",
        "polarity"
      ],
      "title": "UnsupportedCondition",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "StructuredQuery 1.0: one natural-language query structured with the K-Fashion standard\nvocabulary. Definition: contracts/agents/orchestrator/output/structured-query.md (owner: vogue-orchestrator).\n\n`items` are in the order the user named them (decision IT-4: the pipeline takes one item today, so\nonly `items[0]` is forwarded to trend). Season and trend names are query-wide (`trend_terms`,\ndecision IT-5″). The assembler always writes at least one item: with no named item, or only\nout-of-scope ones, one item with `category: null` (IT-6, IT-7′). The model still accepts `[]`.",
  "properties": {
    "items": {
      "items": {
