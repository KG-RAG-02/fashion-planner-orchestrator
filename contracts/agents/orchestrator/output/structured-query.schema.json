            "$ref": "#/$defs/SeasonRequest"
          },
          "minItems": 1,
          "title": "Seasons",
          "type": "array"
        },
        "style_names": {
          "items": {
            "$ref": "#/$defs/TermRef"
          },
          "title": "Style Names",
          "type": "array"
        }
      },
      "required": [
        "seasons",
        "style_names",
        "product_model_names"
      ],
      "title": "TrendTerms",
      "type": "object"
    },
    "UnsupportedCondition": {
      "additionalProperties": false,
      "description": "A requested condition the vocabulary or this contract cannot express; recorded, never dropped.",
      "properties": {
