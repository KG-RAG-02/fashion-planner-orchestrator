    "GenderFilter": {
      "additionalProperties": false,
      "description": "Decision G-3. Genders to select = the include values when there are any (minus excluded ones),\notherwise all three standard genders minus the excluded ones; both empty = no gender filter.\nEntries with value null (match none) take no part in that. Code never rewrites an exclusion into the\ncomplement (\"남성 말고\" stays exclude [남]; it means 여·공용 by this definition).",
      "properties": {
        "exclude": {
          "items": {
            "$ref": "#/$defs/GenderRef"
          },
          "title": "Exclude",
          "type": "array"
        },
        "include": {
          "items": {
            "$ref": "#/$defs/GenderRef"
          },
          "title": "Include",
          "type": "array"
